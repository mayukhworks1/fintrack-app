# Optional local overrides: copy to frontend/.env.local (gitignored).
# Production builds on Vercel take VITE_API_URL from the Vercel project env.
# Unset, vite.config.js defaults it to the production API below, in
# `npm run dev` as well, so a dev server talks to production unless overridden.

# API origin compiled into src/services/api.js and the preconnect in index.html.
VITE_API_URL=https://mayukhj24-fintrack-api.hf.space
# Local backend (its CORS allows http://localhost:5173 when FRONTEND_URL is unset):
# VITE_API_URL=http://localhost:8000

# Target of the dev server's /api proxy (vite.config.js; default http://localhost:8000).
# VITE_PROXY_TARGET=http://localhost:8000
