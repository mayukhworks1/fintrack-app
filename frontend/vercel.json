{
  "rewrites": [
    {
      "source": "/p/:slug/preview.png",
      "destination": "https://mayukhj24-fintrack-api.hf.space/api/public/pages/:slug/og.png"
    },
    {
      "source": "/p/:slug",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": ".*(facebookexternalhit|Facebot|WhatsApp/|LinkedInBot|Slackbot|Slack-ImgProxy|Twitterbot|TelegramBot|Discordbot|SkypeUriPreview|MicrosoftPreview|Pinterestbot|redditbot|Applebot|Googlebot|bingbot|Embedly|Iframely|vkShare|Google-PageRenderer).*"
        }
      ],
      "destination": "https://mayukhj24-fintrack-api.hf.space/api/public/pages/:slug/share"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
