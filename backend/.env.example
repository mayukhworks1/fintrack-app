TEABLE_API_TOKEN=your_teable_token_here
TEABLE_BASE_URL=https://app.teable.ai
TEABLE_TABLE_ID=tbl4fi155DuWlh40By3
OPENROUTER_API_KEY=your_openrouter_key_here
OPENROUTER_MODEL=mistralai/mistral-7b-instruct:free

# Fallback AI provider. Every OpenRouter model in the cascade is on a free tier
# rate-limited per account, so they can all be exhausted at once and every AI
# feature fails together. Groq has its own key and its own quota and is tried
# only after OpenRouter is spent. Optional — leave unset to disable.
GROQ_API_KEY=
GROQ_MODELS=llama-3.3-70b-versatile,llama-3.1-8b-instant
FRONTEND_URL=https://your-app.pages.dev
APP_SECRET=replace_with_a_long_random_session_signing_secret

# Email/password auth delivery.
# HF Spaces blocks SMTP ports, so the backend uses Brevo HTTPS API.
BREVOAPIKEY=your_brevo_api_key
SMTP_FROM_EMAIL=your-address@yourdomain.com
SMTP_FROM_NAME=FinTrack
AUTH_ADMIN_NOTIFY_EMAIL=admin-address@yourdomain.com
PASSWORD_RESET_TTL_MINUTES=30

# Google SSO.
# Google Cloud OAuth Client type: Web application
# Authorized redirect URI: https://your-api-host/api/auth/google/callback
GOOGLE_CLIENT_ID=your_google_oauth_client_id
GOOGLE_CLIENT_SECRET=your_google_oauth_client_secret
GOOGLE_REDIRECT_URI=https://your-api-host/api/auth/google/callback
