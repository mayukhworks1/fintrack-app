TEABLE_API_TOKEN=your_teable_token_here
TEABLE_BASE_URL=https://app.teable.ai
TEABLE_TABLE_ID=tbl4fi155DuWlh40By3

# AI providers. Keys, models, routes, daily caps and prompts are managed by a
# superadmin in Admin → AI gateway; a key saved there wins over these. The env
# keys are an optional fallback, used by a provider with no saved key, so a new
# deployment works before anyone opens the panel. They are only sent to the
# provider's own API: a provider whose base URL is moved to another host in
# the panel needs a key saved there. Embeddings need OpenRouter.
OPENROUTER_API_KEY=
GROQ_API_KEY=
# Derives the key that encrypts provider keys saved in the panel. Optional:
# without it APP_SECRET is used, and rotating APP_SECRET then makes the saved
# keys unreadable until they are set again. Keys saved before this is set stay
# readable through APP_SECRET; save them again before rotating APP_SECRET.
AI_GATEWAY_SECRET=

# Origin(s) of the frontend, comma-separated (production: https://twfintracker.worksmayukh.space).
FRONTEND_URL=https://your-frontend-domain

# Signs every session token, and the token carries the user's role — so a known
# value lets anyone mint a superadmin token. Generate with:
#   openssl rand -base64 48
# The built-in fallback is published in this public repo, so the backend refuses
# to start on it unless APP_ENV marks the machine as development.
APP_SECRET=replace_with_a_long_random_session_signing_secret

# production (default) | development
# Only relax this on a developer machine. Leaving it unset means production,
# which is the safe way round to be wrong.
APP_ENV=development

# Email/password auth delivery.
# HF Spaces blocks SMTP ports, so the backend uses Brevo HTTPS API.
BREVOAPIKEY=your_brevo_api_key
SMTP_FROM_EMAIL=your-address@yourdomain.com
SMTP_FROM_NAME=FinTrack
AUTH_ADMIN_NOTIFY_EMAIL=admin-address@yourdomain.com
PASSWORD_RESET_TTL_MINUTES=30

# Google SSO.
# Google Cloud OAuth Client type: Web application
# Authorized redirect URI: https://your-api-host/api/auth/google/callback
GOOGLE_CLIENT_ID=your_google_oauth_client_id
GOOGLE_CLIENT_SECRET=your_google_oauth_client_secret
GOOGLE_REDIRECT_URI=https://your-api-host/api/auth/google/callback

# Alerting. Fires when a background loop dies, Teable sync goes stale,
# PostgreSQL is unreachable, the connection pool is exhausted, or 5xx
# responses spike. Set one or both; with neither, alerting is off.
# Webhook: a Slack/Discord incoming-webhook URL, or any endpoint that accepts
# a JSON POST with a "text" field. Email goes through Brevo (BREVOAPIKEY).
# Verify delivery with POST /api/admin/alerts/test from the admin panel.
ALERT_WEBHOOK_URL=
ALERT_EMAIL_TO=

# Client IP behind the login rate limit, scanner bans and the audit trail.
# TRUSTED_PROXY_HOPS: proxies that append to X-Forwarded-For in front of the app.
# 1 (default) uses the rightmost entry, the one the platform proxy appended; 0 ignores the header.
# TRUST_CF_CONNECTING_IP: true only if the API is reachable solely through Cloudflare.
# Verify on Hugging Face: curl -H 'X-Forwarded-For: 203.0.113.9' https://<space>.hf.space/api/auth/providers, then the newest Admin > Audit Log row must show your real IP (ifconfig.me), not 203.0.113.9 or an internal 10.x address.
TRUSTED_PROXY_HOPS=1
TRUST_CF_CONNECTING_IP=false

# ── Limits ────────────────────────────────────────────────────────────────────
# MAX_UPLOAD_BYTES: largest upload any route accepts (default 25 MB).
MAX_UPLOAD_BYTES=26214400
# SYNC_LOG_RETENTION_DAYS: sync_log rows older than this are pruned hourly (0 = keep all).
SYNC_LOG_RETENTION_DAYS=14
# LEGACY_AI_DAILY_CALL_LIMIT: rolling-24h AI calls shared by everyone on one legacy
# role password (viewer, web, all, editor, admin each get their own budget).
LEGACY_AI_DAILY_CALL_LIMIT=1000
