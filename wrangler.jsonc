{
  "name": "fintrack-app",
  "main": "frontend/worker/index.js",
  "compatibility_date": "2025-09-01",
  "assets": {
    "directory": "frontend/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/p/*"]
  },
  "observability": { "enabled": true }
}
